# Local runnable prototype (default when this variable is omitted)
VITE_AUTH_MODE=demo

# Netlify deployment after Identity is enabled in the Netlify project
# VITE_AUTH_MODE=netlify

# Netlify AI Gateway automatically injects its own credentials on deploy.
# Pin the production model so behavior does not change unexpectedly.
AI_EMOTION_MODEL=deepseek/deepseek-v4-flash-0731

# Optional direct DeepSeek fallback. Keep the real key in Netlify environment variables,
# never in this file or any VITE_ variable.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
