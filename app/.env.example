# Local runnable prototype (default when this variable is omitted)
VITE_AUTH_MODE=demo

# Netlify deployment after Identity is enabled in the Netlify project
# VITE_AUTH_MODE=netlify

# Netlify AI Gateway automatically injects its own credentials on deploy.
# DeepSeek currently routes V4 Pro requests to V4.1 Flash during the transition.
# Netlify AI Gateway uses OpenRouter-style model IDs.
AI_EMOTION_MODEL=deepseek/deepseek-v4-pro
# If the routed Pro endpoint rejects image input, retry on the documented vision model.
AI_IMAGE_MODEL=deepseek/deepseek-v4-flash-vision-exp

# Optional direct DeepSeek fallback. Keep the real key in Netlify environment variables,
# never in this file or any VITE_ variable.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_IMAGE_MODEL=deepseek-v4-flash-vision-exp
